# App Store / Play Store build configuration for NotWallet (macOS, iOS, Android).
#
# NotWallet is open source: no account, credential, signing identity, or
# machine-specific path is committed to this repository. Copy this file to an
# untracked `.env.appstore`, fill in the real values, and the build scripts
# auto-load it:
#
#   cp .env.appstore.example .env.appstore   # then edit
#   make asmacos        # or: make asios / make psmobile
#
# Find values with:
#   security find-identity -v                     # signing identities
#   App Store Connect → Users & Access → Integrations → App Store Connect API

# ── macOS (make asmacos) ───────────────────────────────────────────────────
# Installer cert ("3rd Party Mac Developer Installer: …" or its SHA-1).
# NOTE: this is the *Installer* cert used by productbuild — distinct from
# APP_SIGNING_IDENTITY below.
SIGNING_IDENTITY=
# App codesigning cert ("3rd Party Mac Developer Application: …" or its SHA-1),
# used by Tauri to sign the .app bundle itself.
APP_SIGNING_IDENTITY=
# Absolute path to the macOS App Store provisioning profile for the app's bundle
# id, from developer.apple.com → Certificates, Identifiers & Profiles → Profiles.
# Embedded into the .app as Contents/embedded.provisionprofile.
PROVISIONPROFILE_PATH=

# ── iOS (make asios) ───────────────────────────────────────────────────────
# Distribution identity used by the fixplist re-sign
# ("Apple Distribution: …" or its SHA-1 fingerprint).
SIGN_IDENTITY=
# Apple Developer Team ID (10 characters), from Membership details at
# https://developer.apple.com/account. The init and build steps patch this over
# the "your_team_id" placeholder committed in src-tauri/tauri.conf.json.
APPLE_DEVELOPMENT_TEAM=

# ── App Store Connect API (make asmacos-upload / make asios-upload) ────────
# ASC_API_KEY   — Key ID from App Store Connect → Users & Access → Keys.
# ASC_ISSUER_ID — Issuer UUID on the same page.
# The matching private key must be at:
#   ~/.appstoreconnect/private_keys/AuthKey_<ASC_API_KEY>.p8
ASC_API_KEY=
ASC_ISSUER_ID=

# ── Android (make psmobile) ────────────────────────────────────────────────
# Absolute path to the Play Store upload keystore (.jks).
KEYSTORE_PATH=

# ── Optional overrides ─────────────────────────────────────────────────────
# Pin a release Xcode when the machine's global xcode-select points at a beta.
# DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
#
# Build `tauri ios init` from a local Tauri checkout instead of the installed CLI.
# TAURI_CLI_MANIFEST=
